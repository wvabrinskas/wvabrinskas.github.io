{"topicSections":[{"generated":true,"identifiers":["doc:\/\/Neuron\/documentation\/Neuron\/MetalCommandStream\/commandsPerCommit"],"title":"Instance Properties","anchor":"Instance-Properties"},{"generated":true,"identifiers":["doc:\/\/Neuron\/documentation\/Neuron\/MetalCommandStream\/commit()","doc:\/\/Neuron\/documentation\/Neuron\/MetalCommandStream\/synchronize()"],"title":"Instance Methods","anchor":"Instance-Methods"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/Neuron\/documentation\/Neuron"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MetalCommandStream"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"GPU operations encode into the current command buffer and return immediately; nothing waits"},{"type":"text","text":" "},{"type":"text","text":"for the GPU until the CPU actually needs a result. That happens in one of three ways:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"CPU code touches a buffer a queued command uses. ","type":"text"},{"type":"codeVoice","code":"TensorStorage.pointer"},{"text":" checks the","type":"text"},{"text":" ","type":"text"},{"text":"buffer’s ","type":"text"},{"type":"codeVoice","code":"GPUResidency"},{"text":" and calls ","type":"text"},{"type":"codeVoice","code":"synchronize()"},{"text":". This is the normal path, and it is what","type":"text"},{"text":" ","type":"text"},{"text":"makes lazy execution safe: there is no synchronization point to forget.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Someone calls ","type":"text"},{"type":"codeVoice","code":"synchronize()"},{"text":" explicitly (e.g. ","type":"text"},{"type":"codeVoice","code":"Device.synchronize()"},{"text":").","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The current command buffer reaches ","type":"text"},{"type":"codeVoice","code":"commandsPerCommit"},{"text":" commands. It is committed ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"without"}]},{"text":" ","type":"text"},{"text":"waiting, so the GPU starts on earlier layers while the CPU is still encoding later ones.","type":"text"}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"Each command buffer gets a consecutive "},{"type":"emphasis","inlineContent":[{"text":"generation","type":"text"}]},{"type":"text","text":". Buffers record the generation of the last"},{"type":"text","text":" "},{"type":"text","text":"command that bound them, and "},{"type":"codeVoice","code":"completedGeneration"},{"type":"text","text":" is the highest generation for which every"},{"type":"text","text":" "},{"type":"text","text":"command buffer up to and including it has finished. A buffer is safe for the CPU when its last"},{"type":"text","text":" "},{"type":"text","text":"generation is complete."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A training step therefore waits for the GPU about twice: once when the loss reads the network"},{"type":"text","text":" "},{"type":"text","text":"output, and once when the optimizer reads the gradients."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Every entry point drains its own autorelease pool. Metal returns command buffers and encoders"},{"type":"text","text":" "},{"type":"text","text":"autoreleased, and callers can’t be relied on to drain: "},{"type":"codeVoice","code":"Classifier.fit"},{"type":"text","text":" runs a whole training"},{"type":"text","text":" "},{"type":"text","text":"run inside one pool, so the encoder the optimizer update created each step accumulated for the"},{"type":"text","text":" "},{"type":"text","text":"entire run. The stream holds its own strong references to the objects it keeps."}],"type":"paragraph"}]}],"kind":"symbol","sections":[],"metadata":{"role":"symbol","title":"MetalCommandStream","navigatorTitle":[{"text":"MetalCommandStream","kind":"identifier"}],"roleHeading":"Class","modules":[{"name":"Neuron"}],"externalID":"s:6Neuron18MetalCommandStreamC","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MetalCommandStream"}],"symbolKind":"class"},"abstract":[{"text":"A serial stream of GPU commands that is committed lazily.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Neuron\/documentation\/Neuron\/MetalCommandStream"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/neuron\/metalcommandstream"]}],"references":{"doc://Neuron/documentation/Neuron/MetalCommandStream/commit()":{"identifier":"doc:\/\/Neuron\/documentation\/Neuron\/MetalCommandStream\/commit()","url":"\/documentation\/neuron\/metalcommandstream\/commit()","kind":"symbol","type":"topic","role":"symbol","abstract":[{"text":"Commits the current command buffer without waiting for it.","type":"text"}],"title":"commit()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"commit","kind":"identifier"},{"text":"()","kind":"text"}]},"doc://Neuron/documentation/Neuron":{"abstract":[],"identifier":"doc:\/\/Neuron\/documentation\/Neuron","type":"topic","url":"\/documentation\/neuron","title":"Neuron","role":"collection","kind":"symbol"},"doc://Neuron/documentation/Neuron/MetalCommandStream/synchronize()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"synchronize"},{"kind":"text","text":"()"}],"identifier":"doc:\/\/Neuron\/documentation\/Neuron\/MetalCommandStream\/synchronize()","title":"synchronize()","kind":"symbol","abstract":[{"text":"Commits any queued work and blocks until every command buffer ha