l","type":"topic","abstract":[{"type":"codeVoice","code":"b1 | b2"},{"type":"text","text":", packed flat, as the backward packs the bias gradients."}]},"doc://Neuron/Se":{"title":"Swift.Decodable","type":"unresolvable","identifier":"doc:\/\/Neuron\/Se"},"doc://Neuron/documentation/Neuron/MixtureOfExperts/apply(gradients:learningRate:)":{"url":"\/documentation\/neuron\/mixtureofexperts\/apply(gradients:learningrate:)","title":"apply(gradients:learningRate:)","identifier":"doc:\/\/Neuron\/documentation\/Neuron\/MixtureOfExperts\/apply(gradients:learningRate:)","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"apply"},{"kind":"text","text":"("},{"kind":"externalParam","text":"gradients"},{"kind":"text","text":": (weights"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Neuron6TensorC","text":"Tensor"},{"kind":"text","text":", biases"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Neuron6TensorC","text":"Tensor"},{"kind":"text","text":"), "},{"kind":"externalParam","text":"learningRate"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Neuron6TensorC","text":"Tensor"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:6Neuron6TensorC6Scalara","text":"Scalar"},{"kind":"text","text":")"}],"role":"symbol","type":"topic","abstract":[{"type":"text","text":"Applies parameter updates, subtracting each from its parameter. The optimizer has already"},{"type":"text","text":" "},{"type":"text","text":"scaled the gradients."}]},"doc://Neuron/documentation/Neuron/MixtureOfExperts/encode(to:)":{"url":"\/documentation\/neuron\/mixtureofexperts\/encode(to:)","title":"encode(to:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"encode"},{"kind":"text","text":"("},{"kind":"externalParam","text":"to"},{"kind":"text","text":": any "},{"kind":"typeIdentifier",