cingCoefficient"},{"text":": 1 when","type":"text"},{"text":" ","type":"text"},{"text":"every expert gets the same share of tokens and probability, up to ","type":"text"},{"type":"codeVoice","code":"E"},{"text":" when one gets all of","type":"text"},{"text":" ","type":"text"},{"text":"both. ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" before the first forward. Reading it waits for queued GPU work.","type":"text"}],"url":"\/documentation\/neuron\/mixtureofexperts\/loadbalancingloss","identifier":"doc:\/\/Neuron\/documentation\/Neuron\/MixtureOfExperts\/loadBalancingLoss","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"loadBalancingLoss"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Tensor","preciseIdentifier":"s:6Neuron6TensorC"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Scalar","preciseIdentifier":"s:6Neuron6TensorC6Scalara"},{"kind":"text","text":"?"}]},"doc://Neuron/documentation/Neuron/MixtureOfExperts/apply(gradients:learningRate:)":{"title":"apply(gradients:learningRate:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"apply","kind":"identifier"},{"text":"(","kind":"text"},{"text":"gradients","kind":"externalParam"},{"text":": (weights","kind":"text"},{"text":": ","kind":"text"},{"text":"Tensor","kind":"typeIdentifier","preciseIdentifier":"s:6Neuron6TensorC"},{"text":", biases","kind":"text"},{"text":": ","kind":"text"},{"text":"Tensor","kind":"typeIdentifier","preciseIdentifier":"s:6Neuron6TensorC"},{"text":"), ","kind":"text"},{"text":"learningRate","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Tensor","kind":"typeIdentifier","preciseIdentifier":"s:6Neuron6TensorC"},{"text":".","kind":"text"},{"text":"Scalar","kind":"typeIdentifier","preciseIdentifier":"s:6Neuron6TensorC6Scalara"},{"text":")","kind":"text"}],"type":"topic","abstract":[{"text":"Applies parameter updates, subtracting each from its parameter. The optimizer has already","type":"text"},{"text":" ","type":"text"},{"text":"scaled the gradients.","type":"text"}],"identifier":"doc:\/\/Neuron\/documentation\/Neuron\/MixtureOfExperts\/apply(gradients:learningRate:)","url":"\/documentation\/neuron\/mixtureofexperts\/apply(gradients:learningrate:)","role":"symbol","kind":"symbol"},"doc://Neuron/Se":{"identifier":"doc:\/\/Neuron\/Se","title":"Swift.Decodable","type":"unresolvable"},"doc://Neuron/documentation/Neuron/MixtureOfExperts/weights":{"title":"weights","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"weights","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Tensor","kind":"typeIdentifier","preciseIdentifier":"s:6Neuron6TensorC"}],"type":"topic","abstract":[{"code":"W_r | W1 | W2","type":"codeVoice"},{"text":", packed flat: the layout the backward packs the weight gradients in. Setting","type":"text"},{"text":" ","type":"text"},{"text":"it unpacks by the same offsets.","type":"text"}],"identifier":"doc:\/\/Neuron\/documentation\/Neuron\/MixtureOfExperts\/weights","url":"\/documentation\/neuron\/mixtureofexperts\/weights","role":"symbol","kind":"symbol"},"doc://Neuron/documentation/Neuron/Layer":{"role":"symbol","title":"Layer","navigatorTitle":[{"kind":"identifier","text":"Layer"}],"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The primary protocol that every neural network layer must conform to."}],"url":"\/documentation\/neuron\/layer","identifier":"doc:\/\/Neuron\/documentation\/Neuron\/Layer","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Layer"}]},"doc://Neuron/documentation/Neuron/MixtureOfExperts/onInputSizeSet()":{"role":"symbol","title":"onInputSizeSet()","kind":"symbol","type":"topic","abstract":[{"text":"Called by ","type":"text"},{"code":"Sequential.compile()","type":"codeVoice"},{"text":" when the input size is set. The output has the input’s","type":"text"},{"text":" ","type":"text"},{"text":"shape. Creates the parameters unless they already have the right size: ","type":"text"},{"code":"compile","type":"codeVoice"},{"text":" sets","type":"text"},{"text":" ","type":"text"},{"code":"inputSize","type":"codeVoice"},{"text":" again on every call, including after a model is decoded.","type":"text"}],"identifier":"doc:\/\/Neuron\/documentation\/Neuron\/MixtureOfExperts\/onInputSizeSet()","url":"\/documentation\/neuron\/mixtureofexperts\/oninputsizeset()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onInputSizeSet","kind":"identifier"},{"text":"()","kind":"text"}]},"doc://Neuron/documentation/Neuron":{"abstract":[],"identifier":"doc:\/\/Neuron\/documentation\/Neuron","type":"topic","url":"\/documentation\/neuron","title":"Neuron","role":"collection","kind":"symbol"},"doc://Neuron/documentation/Neuron/MixtureOfExperts/experts":{"title":"experts","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"experts","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"type":"topic","abstract":[{"text":"Expert MLPs, ","type":"text"},{"code":"E","type":"codeVoice"},{"text":".","type":"text"}],"identifier":"doc:\/\/Neuron\/documentation\/Neuron\/MixtureOfExperts\/experts","url":"\/documentation\/neuron\/mixtureofexperts\/experts","role":"symbol","kind":"symbol"},"doc://Neuron/documentation/Neuron/MixtureOfExperts/expertLoad":{"title":"expertLoad","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"expertLoad","kind":"identifier"},{"text":": [","kind":"text"},{"text":"Tensor","kind":"typeIdentifier","preciseIdentifier":"s:6Neuron6TensorC"},{"text":".","kind":"text"},{"text":"Scalar","kind":"typeIdentifier","preciseIdentifier":"s:6Neuron6TensorC6Scalara"},{"text":"]?","kind":"text"}],"type":"topic","abstract":[{"text":"The last forward’s ","type":"text"},{"code":"f","type":"codeVoice"},{"text":": the share o