{"schemaVersion":{"major":0,"minor":3,"patch":0},"topicSections":[{"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/Neuron\/documentation\/Neuron\/MixtureOfExperts\/init(from:)","doc:\/\/Neuron\/documentation\/Neuron\/MixtureOfExperts\/init(inputSize:experts:topK:hiddenUnits:loadBalancingCoefficient:initializer:outputInitializer:allowsWeightDecay:linkId:)"],"generated":true},{"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/Neuron\/documentation\/Neuron\/MixtureOfExperts\/biases","doc:\/\/Neuron\/documentation\/Neuron\/MixtureOfExperts\/expertLoad","doc:\/\/Neuron\/documentation\/Neuron\/MixtureOfExperts\/experts","doc:\/\/Neuron\/documentation\/Neuron\/MixtureOfExperts\/hiddenUnits","doc:\/\/Neuron\/documentation\/Neuron\/MixtureOfExperts\/loadBalancingCoefficient","doc:\/\/Neuron\/documentation\/Neuron\/MixtureOfExperts\/loadBalancingLoss","doc:\/\/Neuron\/documentation\/Neuron\/MixtureOfExperts\/topK","doc:\/\/Neuron\/documentation\/Neuron\/MixtureOfExperts\/weights"],"generated":true},{"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/Neuron\/documentation\/Neuron\/MixtureOfExperts\/apply(gradients:learningRate:)","doc:\/\/Neuron\/documentation\/Neuron\/MixtureOfExperts\/encode(to:)","doc:\/\/Neuron\/documentation\/Neuron\/MixtureOfExperts\/forward(tensor:context:)","doc:\/\/Neuron\/documentation\/Neuron\/MixtureOfExperts\/onInputSizeSet()"],"generated":true}],"relationshipsSections":[{"type":"inheritsFrom","title":"Inherits From","identifiers":["doc:\/\/Neuron\/documentation\/Neuron\/BaseLayer"],"kind":"relationships"},{"type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/Neuron\/documentation\/Neuron\/Layer","doc:\/\/Neuron\/Se","doc:\/\/Neuron\/SE"],"kind":"relationships"}],"metadata":{"symbolKind":"class","navigatorTitle":[{"kind":"identifier","text":"MixtureOfExperts"}],"title":"MixtureOfExperts","roleHeading":"Class","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MixtureOfExperts","kind":"identifier"}],"modules":[{"name":"Neuron"}],"role":"symbol","externalID":"s:6Neuron16MixtureOfExpertsC"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Neuron\/documentation\/Neuron\/MixtureOfExperts"},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MixtureOfExperts","kind":"identifier"}]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"inlineContent":[{"text":"Each token ","type":"text"},{"type":"codeVoice","code":"x"},{"text":" (a row of ","type":"text"},{"type":"codeVoice","code":"C"},{"text":" features) is processed independently:","type":"text"}],"type":"paragraph"},{"code":["z      = x W_rᵀ                                     router logits (E)","g      = softmax over the top k of z, 0 elsewhere   gates; Σ g = 1","eₑ(x)  = W2ₑ GeLU(W1ₑ x + b1ₑ) + b2ₑ                expert e, hidden width F","y      = Σₑ gₑ eₑ(x)                                only the k nonzero gates contribute"],"syntax":null,"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The softmax over the top "},{"code":"k","type":"codeVoice"},{"type":"text","text":" is the full softmax restricted to them and renormalized. Top-k"},{"type":"text","text":" "},{"type":"text","text":"selection isn’t differentiable: the router’s gradient flows only through the kept gates, and an"},{"type":"text","text":" "},{"type":"text","text":"expert a token didn’t choose gets no gradient from it. Ties go to the lower expert."}]},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Compute (dense-gated)."}]},{"text":" Every expert runs on every token and the unkept gates zero their","type":"text"},{"text":" ","type":"text"},{"text":"outputs, so the result and every gradient are what sparse dispatch would give, at ","type":"text"},{"type":"codeVoice","code":"E \/ k"},{"text":" times","type":"text"},{"text":" ","type":"text"},{"text":"the feed-forward compute. Nothing is read on the CPU mid-pass and every shape is fixed. Because","type":"text"},{"type":"text","text":" "},{"text":"the second projection is linear, ","type":"text"},{"code":"Σₑ gₑ (W2ₑ hₑ + b2ₑ) = (g ⊙ h) W2ᵀ + g b2","type":"codeVoice"},{"type":"text","text":", with "},{"code":"g","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"repeated over each expert’s "},{"code":"F","type":"codeVoice"},{"text":" hidden units: the whole layer is five matrix products (router,","type":"text"},{"type":"text","text":" "},{"text":"first projections, gate expansion, second projections, biases) and a top-k softmax. See","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"docs\/LEARNINGS.md"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Load balancing."}],"type":"strong"},{"text":" Without help the router collapses onto a few experts. When","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"loadBalancingCoefficient"},{"text":" (","type":"text"},{"type":"codeVoice","code":"α"},{"text":") is above 0, training adds the Switch Transformer auxiliary loss","type":"text"}],"type":"paragraph"},{"code":["L_aux = E · Σᵢ fᵢ Pᵢ,  fᵢ = share of the batch's n·k assignments that went to expert i","                       Pᵢ = mean router probability softmax(z)ᵢ over the batch's n tokens"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"which is 1 when routing is perfectly balanced. ","type":"text"},{"type":"codeVoice","code":"f"},{"text":" counts selections, so it has no gradient.","type":"text"},{"text":" ","type":"text"},{"text":"The layer adds ","type":"text"},{"type":"codeVoice","code":"α"},{"text":"-weighted ","type":"text"},{"type":"codeVoice","code":"L_aux"},{"text":" gradients in its own backward, as one more per-token loss","type":"text"},{"text":" ","type":"text"},{"text":"term: every token’s router probabilities receive ","type":"text"},{"type":"codeVoice","code":"α · E · f"},{"text":". That is the weight a per-token","type":"text"},{"text":" ","type":"text"},{"text":"loss carries in Neuron, whose losses sum a sequence’s per-token gradients, so ","type":"text"},{"code":"α","type":"codeVoice"},{"text":" means what it","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"does in Switch (0.01). The balancing gradient mixes the batch’s tokens, and it is added only"},{"type":"text","text":" "},{"text":"when the forward ran in training. It isn’t part of the loss the optimizer reports; read","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"loadBalancingLoss"},{"text":" for it.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Parameters."}],"type":"strong"},{"type":"text","text":" One row per output feature, as "},{"code":"Linear","type":"codeVoice"},{"type":"text","text":" and PyTorch’s "},{"code":"nn.Linear.weight","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"store them:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"W_r"},{"type":"text","text":", "},{"type":"codeVoice","code":"(columns: C, rows: E)"},{"type":"text","text":", no bias."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"W1"},{"type":"text","text":", "},{"type":"codeVoice","code":"(columns: C, rows: E·F)"},{"type":"text","text":": rows "},{"type":"codeVoice","code":"e·F..<(e+1)·F"},{"type":"text","text":" are expert "},{"type":"codeVoice","code":"e"},{"type":"text","text":"’s first projection."},{"type":"text","text":" "},{"type":"codeVoice","code":"b1"},{"type":"text","text":", "},{"type":"codeVoice","code":"(columns: E·F)"},{"type":"text","text":", in the same order."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"W2","type":"codeVoice"},{"type":"text","text":", "},{"code":"(columns: E·F, rows: C)","type":"codeVoice"},{"type":"text","text":": columns "},{"code":"e·F..<(e+1)·F","type":"codeVoice"},{"type":"text","text":" are expert "},{"type":"codeVoice","code":"e"},{"type":"text","text":"’s second projection."},{"type":"text","text":" "},{"type":"codeVoice","code":"b2"},{"type":"text","text":", "},{"type":"codeVoice","code":"(columns: C, rows: E)"},{"type":"text","text":": row "},{"type":"codeVoice","code":"e"},{"type":"text","text":" is expert "},{"type":"codeVoice","code":"e"},{"type":"text","text":"’s."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"weights"},{"type":"text","text":" is "},{"code":"W_r | W1 | W2","type":"codeVoice"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"biases"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"b1 | b2"},{"type":"text","text":", packed flat, the layout the backward"},{"type":"text","text":" "},{"type":"text","text":"returns gradients in. "},{"type":"codeVoice","code":"Adam"},{"text":" decays ","type":"text"},{"type":"codeVoice","code":"weights"},{"type":"text","text":", router included, unless "},{"type":"codeVoice","code":"allowsWeightDecay"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"codeVoice","code":"false"},{"type":"text","text":", and never decays biases."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each sample is "},{"type":"codeVoice","code":"(columns: C, rows: R, depth: D)"},{"type":"text","text":", read as "},{"type":"codeVoice","code":"R·D"},{"type":"text","text":" tokens, and the output has the"},{"type":"text","text":" "},{"type":"text","text":"same shape. The layer is position-wise, so it accepts sequences shorter than "},{"type":"codeVoice","code":"inputSize.depth"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Every forward pass receives the whole mini-batch packed into one tensor ("},{"type":"codeVoice","code":"size.batchCount"},{"type":"text","text":" "},{"type":"text","text":"samples of "},{"type":"codeVoice","code":"inputSize"},{"type":"text","text":"). See "},{"type":"codeVoice","code":"docs\/WRITING_A_LAYER.md"},{"type":"text","text":"."}]}],"kind":"content"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Neuron\/documentation\/Neuron"]]},"variants":[{"paths":["\/documentation\/neuron\/mixtureofexperts"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"abstract":[{"type":"text","text":"A sparse mixture-of-experts feed-forward layer, the MLP of a GPT-4-shaped (Switch \/ Mixtral)"},{"type":"text","text":" "},{"type":"text","text":"transformer block: a router sends each token through "},{"code":"k","type":"codeVoice"},{"type":"text","text":" of "},{"code":"E","type":"codeVoice"},{"type":"text","text":" expert MLPs and blends their"},{"type":"text","text":" "},{"type":"text","text":"outputs by gate weight."}],"references":{"doc://Neuron/documentation/Neuron/MixtureOfExperts":{"navigatorTitle":[{"kind":"identifier","text":"MixtureOfExperts"}],"identifier":"doc:\/\/Neuron\/documentation\/Neuron\/MixtureOfExperts","title":"MixtureOfExperts","kind":"symbol","url":"\/documentation\/neuron\/mixtureofexperts","abstract":[{"type":"text","text":"A sparse mixture-of-experts feed-forward layer, the MLP of a GPT-4-shaped (Switch \/ Mixtral)"},{"type":"text","text":" "},{"type":"text","text":"transformer block: a router sends each token through "},{"code":"k","type":"codeVoice"},{"type":"text","text":" of "},{"code":"E","type":"codeVoice"},{"type":"text","text":" expert MLPs and blends their"},{"type":"text","text":" "},{"type":"text","text":"outputs by gate weight."}],"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MixtureOfExperts"}]},"doc://Neuron/documentation/Neuron/MixtureOfExperts/topK":{"url":"\/documentation\/neuron\/mixtureofexperts\/topk","title":"topK","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"topK"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"kind":"symbol","identifier":"doc:\/\/Neuron\/documentation\/Neuron\/MixtureOfExperts\/topK","role":"symbol","abstract":[{"type":"text","text":"Experts each token goes through, "},{"type":"codeVoice","code":"k"},{"type":"text","text":", "},{"type":"codeVoice","code":"1...E"},{"type":"text","text":"."}],"type":"topic"},"doc://Neuron/documentation/Neuron/MixtureOfExperts/expertLoad":{"url":"\/documentation\/neuron\/mixtureofexperts\/expertload","title":"expertLoad","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"expertLoad"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:6Neuron6TensorC","text":"Tensor"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:6Neuron6TensorC6Scalara","text":"Scalar"},{"kind":"text","text":"]?"}],"kind":"symbol","identifier":"doc:\/\/Neuron\/documentation\/Neuron\/MixtureOfExperts\/expertLoad","role":"symbol","abstract":[{"type":"text","text":"The last forward’s "},{"code":"f","type":"codeVoice"},{"type":"text","text":": the share of its token-to-expert assignments each expert received."},{"type":"text","text":" "},{"type":"text","text":"Sums to 1; "},{"code":"1 \/ E","type":"codeVoice"},{"type":"text","text":" each when balanced. "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" before the first forward. Reading it waits for"},{"type":"text","text":" "},{"type":"text","text":"queued GPU work."}],"type":"topic"},"doc://Neuron/documentation/Neuron/Layer":{"navigatorTitle":[{"text":"Layer","kind":"identifier"}],"identifier":"doc:\/\/Neuron\/documentation\/Neuron\/Layer","title":"Layer","kind":"symbol","url":"\/documentation\/neuron\/layer","abs