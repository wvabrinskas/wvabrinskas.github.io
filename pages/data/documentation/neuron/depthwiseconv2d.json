r"}]}]},{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"inlineContent":[{"type":"text","text":"Depthwise convolution applies a single convolutional filter independently to each input channel"},{"type":"text","text":" "},{"type":"text","text":"(depth slice), rather than mixing information across channels as a standard "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Neuron\/documentation\/Neuron\/Conv2d"},{"type":"text","text":" does."},{"type":"text","text":" "},{"type":"text","text":"The number of output channels always equals the number of input channels."}],"type":"paragraph"},{"inlineContent":[{"text":"This is the first step in a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"depthwise separable convolution"}]},{"text":" (as used in MobileNet), where it","type":"text"},{"text":" ","type":"text"},{"text":"is typically followed by a pointwise (","type":"text"},{"code":"Conv2d","type":"codeVoice"},{"text":" with a 1×1 kernel) convolution that combines the","type":"text"},{"text":" ","type":"text"},{"text":"per-channel features.","type":"text"}],"type":"paragraph"},{"text":"How it differs from ``doc:\/\/Neuron\/documentation\/Neuron\/Conv2d``","type":"heading","level":2,"anchor":"How-it-differs-from-docNeurondocumentationNeuronConv2d"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Property"}]}],[{"type":"paragraph","inlineContent":[{"code":"Conv2d","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"DepthwiseConv2d","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Filters per channel","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"filterCount","type":"codeVoice"},{"text":" shared across all channels","type":"text"}]}],[{"inlineContent":[{"type":"text","text":"1 dedicated filter per channel"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Output depth"}],"type":"paragraph"}],[{"inlineContent":[{"code":"filterCount","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"same as input depth"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Parameter count"}],"type":"paragraph"}],[{"inlineContent":[{"code":"filterCount × inputDepth × kH × kW","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"inputDepth × kH × kW","type":"codeVoice"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"text":"Usage","type":"heading","level":2,"anchor":"Usage"},{"syntax":"swift","type":"codeListing","code":["\/\/ Stand-alone depthwise conv on a 32×32 RGB image","let layer = DepthwiseConv2d(","    inputSize: TensorSize(rows: 32, columns: 32, depth: 3),","    strides: (1, 1),","    padding: .same,","    filterSize: (3, 3)",")","","\/\/ Typical depthwise-separable block","let sequential = Sequential {[","    DepthwiseConv2d(strides: (1, 1), padding: .same, filterSize: (3, 3)),","    Conv2d(filterCount: 64, filterSize: (1, 1))   \/\/ pointwise step","]}"]},{"text":"Output shape","type":"heading","level":2,"anchor":"Output-shape"},{"inlineContent":[{"type":"text","text":"Given an input of shape "},{"type":"codeVoice","code":"(rows: H, columns: W, depth: D)"},{"type":"text","text":" and filter size "},{"type":"codeVoice","code":"(rows: kH, columns: kW)"},{"type":"text","text":":"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".same"},{"text":" padding","type":"text"}]},{"type":"text","text":": output is "},{"code":"(rows: H\/strideR, columns: W\/strideC, depth: D)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".valid"},{"type":"text","text":" padding"}]},{"type":"text","text":": output is "},{"type":"codeVoice","code":"(rows: (H−kH)\/strideR+1, columns: (W−kW)\/strideC+1, depth: D)"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Gradient co