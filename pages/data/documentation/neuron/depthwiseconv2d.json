{"sections":[],"hierarchy":{"paths":[["doc:\/\/Neuron\/documentation\/Neuron"]]},"abstract":[{"text":"A layer that performs a depthwise 2D convolution operation.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/neuron\/depthwiseconv2d"]}],"relationshipsSections":[{"kind":"relationships","title":"Inherits From","identifiers":["doc:\/\/Neuron\/documentation\/Neuron\/BaseConvolutionalLayer"],"type":"inheritsFrom"},{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/Neuron\/documentation\/Neuron\/ConvolutionalLayer","doc:\/\/Neuron\/documentation\/Neuron\/Layer","doc:\/\/Neuron\/Se","doc:\/\/Neuron\/SE"],"type":"conformsTo"}],"topicSections":[{"anchor":"Initializers","generated":true,"title":"Initializers","identifiers":["doc:\/\/Neuron\/documentation\/Neuron\/DepthwiseConv2d\/init(from:)","doc:\/\/Neuron\/documentation\/Neuron\/DepthwiseConv2d\/init(inputSize:strides:padding:filterSize:initializer:biasEnabled:linkId:encodingType:)"]},{"anchor":"Instance-Methods","generated":true,"title":"Instance Methods","identifiers":["doc:\/\/Neuron\/documentation\/Neuron\/DepthwiseConv2d\/apply(gradients:learningRate:)","doc:\/\/Neuron\/documentation\/Neuron\/DepthwiseConv2d\/encode(to:)","doc:\/\/Neuron\/documentation\/Neuron\/DepthwiseConv2d\/forward(tensor:context:)","doc:\/\/Neuron\/documentation\/Neuron\/DepthwiseConv2d\/onInputSizeSet()"]}],"metadata":{"title":"DepthwiseConv2d","navigatorTitle":[{"text":"DepthwiseConv2d","kind":"identifier"}],"symbolKind":"class","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"DepthwiseConv2d"}],"roleHeading":"Class","externalID":"s:6Neuron15DepthwiseConv2dC","role":"symbol","modules":[{"name":"Neuron"}]},"identifier":{"url":"doc:\/\/Neuron\/documentation\/Neuron\/DepthwiseConv2d","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"DepthwiseConv2d"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Depthwise convolution applies a single convolutional filter independently to each input channel"},{"type":"text","text":" "},{"type":"text","text":"(depth slice), rather than mixing information across channels as a standard "},{"identifier":"doc:\/\/Neuron\/documentation\/Neuron\/Conv2d","type":"reference","isActive":true},{"type":"text","text":" does."},{"type":"text","text":" "},{"type":"text","text":"The number of output channels always equals the number of input channels."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This is the first step in a "},{"inlineContent":[{"type":"text","text":"depthwise separable convolution"}],"type":"strong"},{"type":"text","text":" (as used in MobileNet), where it"},{"type":"text","text":" "},{"type":"text","text":"is typically followed by a pointwise ("},{"code":"Conv2d","type":"codeVoice"},{"type":"text","text":" with a 1×1 kernel) convolution that combines the"},{"type":"text","text":" "},{"type":"text","text":"per-channel features."}],"type":"paragraph"},{"text":"How it differs from ``doc:\/\/Neuron\/documentation\/Neuron\/Conv2d``","anchor":"How-it-differs-from-docNeurondocumentationNeuronConv2d","type":"heading","level":2},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Property"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Conv2d","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"DepthwiseConv2d","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Filters per channel"}],"type":"paragraph"}],[{"inlineContent":[{"code":"filterCount","type":"codeVoice"},{"type":"text","text":" shared across all channels"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"1 dedicated filter per channel"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Output depth"}],"type":"paragraph"}],[{"inlineContent":[{"code":"filterCount","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"same as input depth"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Parameter count"}],"type":"paragraph"}],[{"inlineContent":[{"code":"filterCount × inputDepth × kH × kW","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"inputDepth × kH × kW","type":"codeVoice"}],"type":"paragraph"}]]],"type":"table"},{"text":"Usage","anchor":"Usage","type":"heading","level":2},{"syntax":"swift","code":["\/\/ Stand-alone depthwise conv on a 32×32 RGB image","let layer = DepthwiseConv2d(","    inputSize: TensorSize(rows: 32, columns: 32, depth: 3),","    strides: (1, 1),","    padding: .same,","    filterSize: (3, 3)",")","","\/\/ Typical depthwise-separable block","let sequential = Sequential {[","    DepthwiseConv2d(strides: (1, 1), padding: .same, filterSize: (3, 3)),","    Conv2d(filterCount: 64, filterSize: (1, 1))   \/\/ pointwise step","]}"],"type":"codeListing"},{"text":"Output shape","anchor":"Output-shape","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Given an input of shape "},{"code":"(rows: H, columns: W, depth: D)","type":"codeVoice"},{"type":"text","text":" and filter size "},{"code":"(rows: kH, columns: kW)","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".same","type":"codeVoice"},{"type":"text","text":" padding"}]},{"type":"text","text":": output is "},{"type":"codeVoice","code":"(rows: H\/strideR, columns: W\/strideC, depth: D)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".valid"},{"type":"text","text":" padding"}],"type":"strong"},{"text":": output is ","type":"text"},{"code":"(rows: (H−kH)\/strideR+1, columns: (W−kW)\/strideC+1, depth: D)","type":"codeVoice"}]}]}],"type":"unorderedList"},{"text":"Gradient computation","anchor":"Gradient-computation","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"During backpropagation each filter gradient and input gradient is computed independently per"},{"type":"text","text":" "},{"type":"text","text":"channel using full convolution of the upstream gradient with the flipped filter kernel. This"},{"type":"text","text":" "},{"type":"text","text":"keeps the backward pass embarrassingly parallel across channels."}],"type":"paragraph"}]}],"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://Neuron/documentation/Neuron/DepthwiseConv2d/init(from:)":{"title":"init(from:)","abstract":[{"text":"Decodes a DepthwiseConv2d layer from a serialized model.","type":"text"}],"fragments":[{"kind":"keyword","text":"convenience"},{"kind":"text","text":" "},{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": any "},{"kind":"typeIdentifier","text":"Decoder","preciseIdentifier":"s:s7DecoderP"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}],"identifier":"doc:\/\/Neuron\/documentation\/Neuron\/DepthwiseConv2d\/init(from:)","type":"topic","role":"symbol","kind":"symbol","url":"\/documentation\/neuron\/depthwiseconv2d\/init(from:)"},"doc://Neuron/documentation/Neuron/ConvolutionalLayer":{"title":"ConvolutionalLayer","abstract":[{"text":"A layer that performs a convolution operation.","type":"text"}],"navigatorTitle":[{"text":"ConvolutionalLayer","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"ConvolutionalLayer"}],"identifier":"doc:\/\/Neuron\/documentation\/Neuron\/ConvolutionalLayer","type":"topic","role":"symbol","kind":"symbol","url":"\/documentation\/neuron\/convolutionallayer"},"doc://Neuron/documentation/Neur