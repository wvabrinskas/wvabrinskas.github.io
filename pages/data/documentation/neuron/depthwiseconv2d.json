":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"text":"Depthwise convolution applies a single convolutional filter independently to each input channel","type":"text"},{"text":" ","type":"text"},{"text":"(depth slice), rather than mixing information across channels as a standard ","type":"text"},{"type":"reference","identifier":"doc:\/\/Neuron\/documentation\/Neuron\/Conv2d","isActive":true},{"text":" does.","type":"text"},{"type":"text","text":" "},{"text":"The number of output channels always equals the number of input channels.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This is the first step in a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"depthwise separable convolution"}]},{"type":"text","text":" (as used in MobileNet), where it"},{"type":"text","text":" "},{"type":"text","text":"is typically followed by a pointwise ("},{"type":"codeVoice","code":"Conv2d"},{"type":"text","text":" with a 1×1 kernel) convolution that combines the"},{"type":"text","text":" "},{"type":"text","text":"per-channel features."}],"type":"paragraph"},{"text":"How it differs from ``doc:\/\/Neuron\/documentation\/Neuron\/Conv2d``","type":"heading","level":2,"anchor":"How-it-differs-from-docNeurondocumentationNeuronConv2d"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Property"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Conv2d"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DepthwiseConv2d"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Filters per channel"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"filterCount"},{"type":"text","text":" shared across all channels"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"1 dedicated filter per channel"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Output depth"}]}],[{"type":"paragraph","