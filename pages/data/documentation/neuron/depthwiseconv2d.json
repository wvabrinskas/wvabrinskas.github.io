{"hierarchy":{"paths":[["doc:\/\/Neuron\/documentation\/Neuron"]]},"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"DepthwiseConv2d"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Depthwise convolution applies a single convolutional filter independently to each input channel"},{"type":"text","text":" "},{"type":"text","text":"(depth slice), rather than mixing information across channels as a standard "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Neuron\/documentation\/Neuron\/Conv2d"},{"type":"text","text":" does."},{"type":"text","text":" "},{"type":"text","text":"The number of output channels always equals the number of input channels."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This is the first step in a "},{"type":"strong","inlineContent":[{"text":"depthwise separable convolution","type":"text"}]},{"type":"text","text":" (as used in MobileNet), where it"},{"type":"text","text":" "},{"type":"text","text":"is typically followed by a pointwise ("},{"type":"codeVoice","code":"Conv2d"},{"type":"text","text":" with a 1×1 kernel) convolution that combines the"},{"type":"text","text":" "},{"type":"text","text":"per-channel features."}],"type":"paragraph"},{"anchor":"How-it-differs-from-docNeurondocumentationNeuronConv2d","text":"How it differs from ``doc:\/\/Neuron\/documentation\/Neuron\/Conv2d``","level":2,"type":"heading"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Property"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Conv2d"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DepthwiseConv2d"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Filters per channel"}]}],[{"type":"para