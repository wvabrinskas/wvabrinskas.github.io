"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"nextTokenPair"},{"kind":"text","text":"("},{"kind":"externalParam","text":"for"},{"kind":"text","text":" "},{"kind":"internalParam","text":"item"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"sequenceLength"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"addingBoundaryTokens"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":") -> (data"},{"kind":"text","text":": "},{"preciseIdentifier":"s:6Neuron6TensorC","kind":"typeIdentifier","text":"Tensor","identifier":"doc:\/\/Neuron\/documentation\/Neuron\/Tensor"},{"kind":"text","text":", label"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:6Neuron6TensorC","kind":"typeIdentifier","text":"Tensor","identifier":"doc:\/\/Neuron\/documentation\/Neuron\/Tensor"},{"kind":"text","text":")"}]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"Item to build a training pair from.","type":"text"}],"type":"paragraph"}],"name":"item"},{"content":[{"inlineContent":[{"text":"Token count both tensors are padded or truncated to.","type":"text"}],"type":"paragraph"}],"name":"sequenceLength"},{"content":[{"inlineContent":[{"text":"Wraps the item in ","type":"text"},{"code":"<bos>","type":"codeVoice"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"<eos>"},{"type":"text","text":" when "},{"type":"codeVoice","code":"true"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"addingBoundaryTokens"}]},{"content":[{"anchor":"return-value","type":"heading","text":"Return Value","level":2},{"inlineContent":[{"text":"Input and label tensors, each of depth ","type":"text"},{"code":"sequenceLength","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The label is the input advanced by exactly one token, so at timestep "},{"type":"codeVoice","code":"i"},{"type":"text","text":" the model sees"},{"type":"text","text":" "},{"type":"text","text":"token "},{"type":"codeVoice","code":"i"},{"type":"text","text":" and is scored on token "},{"type":"codeVoice","code":"i + 1"},{"type":"text","text":". The shift has to happen here, on the token"},{"type":"text","text":" "},{"type":"text","text":"sequence – shifting the "},{"inlineContent":[{"type":"text","text":"text"}],"type":"emphasis"},{"type":"text","text":" and re-encoding does not work, because tokenization is"},{"type":"text","text":" "},{"type":"text","text":"not shift-equivariant: dropping the first character of “the cat” re-encodes as"},{"type":"text","text":" "},{"type":"codeVoice","code":"[\"he\", \"cat\", ...]"},{"type":"text","text":", leaving every position after the first identical to the input and"},{"type":"text","text":" "},{"type":"text","text":"training the model to copy rather than predict."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Wrapping in "},{"type":"codeVoice","code":"<bos>"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"<eos>"},{"type":"text","text":" makes the first real token a prediction target and teaches"},{"type":"text","text":" "},{"type":"text","text":"the model to terminate, which is what "},{"type":"codeVoice","code":"RNN.predict"},{"type":"text","text":" keys off to stop generating."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://Neuron/documentation/Neuron/TokenizingDataset/nextTokenPair(for:sequenceLength:addingBoundaryTokens:)":{"abstract":[{"text":"Builds an aligned input\/label pair for next-token prediction.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/Neuron\/documenta