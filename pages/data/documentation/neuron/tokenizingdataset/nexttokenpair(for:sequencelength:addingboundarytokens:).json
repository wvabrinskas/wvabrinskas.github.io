"},{"inlineContent":[{"text":"The label is the input advanced by exactly one token, so at timestep ","type":"text"},{"code":"i","type":"codeVoice"},{"text":" the model sees","type":"text"},{"text":" ","type":"text"},{"text":"token ","type":"text"},{"code":"i","type":"codeVoice"},{"text":" and is scored on token ","type":"text"},{"code":"i + 1","type":"codeVoice"},{"text":". The shift has to happen here, on the token","type":"text"},{"text":" ","type":"text"},{"text":"sequence – shifting the ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"text","type":"text"}]},{"text":" and re-encoding does not work, because tokenization is","type":"text"},{"text":" ","type":"text"},{"text":"not shift-equivariant: dropping the first character of “the cat” re-encodes as","type":"text"},{"text":" ","type":"text"},{"code":"[\"he\", \"cat\", ...]","type":"codeVoice"},{"text":", leaving every position after the first identical to the input and","type":"text"},{"text":" ","type":"text"},{"text":"training the model to copy rather than predict.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Wrapping in ","type":"text"},{"code":"<bos>","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"<eos>","type":"codeVoice"},{"text":" makes the first real token a prediction target and teaches","type":"text"},{"text":" ","type":"text"},{"text":"the model to terminate, which is what ","type":"text"},{"code":"RNN.predict","type":"codeVoice"},{"text":" keys off to stop generating.","type":"text"}],"type":"paragraph"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Neuron\/documentation\/Neuron\/TokenizingDataset\/nextTokenPair(for:sequenceLength:addingBoundaryTokens:)"},"sections":[],"references":{"doc://Neuron/documentation/Neuron":{"abstract":[],"identifier":"doc:\/\/Neuron\/documentation\/Neuron","type":"topic","url":"\/documentation\/neuron","title":"Neuron","role":"collection","kind":"symbol"},"doc://Neuron/documentation/Neuron/TokenizingDataset/nextToken