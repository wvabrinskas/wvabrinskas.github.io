{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Neuron\/documentation\/Neuron\/TransformerBlock"},"topicSections":[{"identifiers":["doc:\/\/Neuron\/documentation\/Neuron\/TransformerBlock\/init(from:)","doc:\/\/Neuron\/documentation\/Neuron\/TransformerBlock\/init(inputSize:heads:feedForward:initializer:outputInitializer:allowsWeightDecay:linkId:)"],"generated":true,"title":"Initializers","anchor":"Initializers"},{"identifiers":["doc:\/\/Neuron\/documentation\/Neuron\/TransformerBlock\/feedForward-swift.property","doc:\/\/Neuron\/documentation\/Neuron\/TransformerBlock\/heads","doc:\/\/Neuron\/documentation\/Neuron\/TransformerBlock\/isTraining","doc:\/\/Neuron\/documentation\/Neuron\/TransformerBlock\/weights"],"generated":true,"title":"Instance Properties","anchor":"Instance-Properties"},{"identifiers":["doc:\/\/Neuron\/documentation\/Neuron\/TransformerBlock\/apply(gradients:learningRate:)","doc:\/\/Neuron\/documentation\/Neuron\/TransformerBlock\/encode(to:)","doc:\/\/Neuron\/documentation\/Neuron\/TransformerBlock\/forward(tensor:context:)","doc:\/\/Neuron\/documentation\/Neuron\/TransformerBlock\/onBatchSizeSet()","doc:\/\/Neuron\/documentation\/Neuron\/TransformerBlock\/onInputSizeSet()"],"generated":true,"title":"Instance Methods","anchor":"Instance-Methods"},{"anchor":"Enumerations","title":"Enumerations","identifiers":["doc:\/\/Neuron\/documentation\/Neuron\/TransformerBlock\/FeedForward-swift.enum"],"generated":true}],"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"symbolKind":"class","roleHeading":"Class","title":"TransformerBlock","externalID":"s:6Neuron16TransformerBlockC","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TransformerBlock","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"TransformerBlock"}],"modules":[{"name":"Neuron"}]},"hierarchy":{"paths":[["doc:\/\/Neuron\/documentation\/Neuron"]]},"sections":[],"kind":"symbol","abstract":[{"type":"text","text":"A pre-norm transformer decoder block, as in GPT-2 (nanoGPT’s "},{"code":"Block","type":"codeVoice"},{"type":"text","text":"):"}],"relationshipsSections":[{"identifiers":["doc:\/\/Neuron\/documentation\/Neuron\/BaseLayerGroup"],"kind":"relationships","title":"Inherits From","type":"inheritsFrom"},{"identifiers":["doc:\/\/Neuron\/documentation\/Neuron\/Layer","doc:\/\/Neuron\/documentation\/Neuron\/LayerGrouping","doc:\/\/Neuron\/Se","doc:\/\/Neuron\/SE"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"final"},{"text":" ","kind":"text"},{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"kind":"identifier","text":"TransformerBlock"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"codeListing","code":["h = x + Attn(LN₁(x))","y = h + MLP(LN₂(h)),   MLP = Linear(4C) → GeLU → Linear(C)"],"syntax":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"With "},{"code":"feedForward: .mixtureOfExperts","type":"codeVoice"},{"type":"text","text":", the MLP is a "},{"code":"MixtureOfExperts","type":"codeVoice"},{"type":"text","text":" instead: each token"},{"type":"text","text":" "},{"type":"text","text":"goes through the top "},{"code":"k","type":"codeVoice"},{"type":"text","text":" of "},{"code":"E","type":"codeVoice"},{"type":"text","text":" such MLPs, as in GPT-4-shaped (Switch \/ Mixtral) models."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both layer norms take statistics per token ("},{"code":"LayerNormalize(normalizing: .columns, epsilon: 1e-5)","type":"codeVoice"},{"type":"text","text":"), and the attention is causal ("},{"code":"MultiHeadAttention(heads: H, causal: true)","type":"codeVoice"},{"type":"text","text":"), so"},{"type":"text","text":" "},{"type":"text","text":"position "},{"code":"t","type":"codeVoice"},{"type":"text","text":" of the output depends only on positions "},{"code":"0...t","type":"codeVoice"},{"type":"text","text":" of the input. Both "},{"code":"Linear","type":"codeVoice"},{"type":"text","text":"s have"},{"type":"text","text":" "},{"type":"text","text":"biases, and there is no dropout. Not yet checked numerically against PyTorch."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Input and output are "},{"type":"codeVoice","code":"(columns: C, rows: 1, depth: T)"},{"type":"text","text":". As with "},{"type":"codeVoice","code":"MultiHeadAttention"},{"type":"text","text":", every"},{"text":" ","type":"text"},{"text":"sample must be exactly ","type":"text"},{"type":"codeVoice","code":"T"},{"text":" tokens long; right-pad a shorter one.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Stacking.","type":"text"}]},{"type":"text","text":" A GPT stacks "},{"type":"codeVoice","code":"N"},{"type":"text","text":" blocks between "},{"type":"codeVoice","code":"PositionalEmbedding"},{"type":"text","text":" and a final"},{"type":"text","text":" "},{"type":"codeVoice","code":"LayerNormalize(normalizing: .columns)"},{"type":"text","text":", and passes "},{"type":"codeVoice","code":"outputInitializer: .normal(std: 0.02 \/ √(2N))"},{"type":"text","text":" so the "},{"type":"codeVoice","code":"2N"},{"type":"text","text":" projections that add into the residual stream start"},{"type":"text","text":" "},{"type":"text","text":"smaller. "},{"type":"codeVoice","code":"RNN.Architecture.transformer"},{"type":"text","text":" builds that stack."}]},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Structure."}],"type":"strong"},{"type":"text","text":" The attention branch ("},{"type":"codeVoice","code":"LN₁"},{"type":"text","text":", "},{"type":"codeVoice","code":"MultiHeadAttention"},{"type":"text","text":") is "},{"type":"codeVoice","code":"innerBlockSequential"},{"type":"text","text":" "},{"type":"text","text":"and the MLP branch ("},{"code":"LN₂","type":"codeVoice"},{"type":"text","text":", then the two "},{"code":"Linear","type":"codeVoice"},{"type":"text","text":"s and the GeLU, or the "},{"code":"MixtureOfExperts","type":"codeVoice"},{"type":"text","text":") is"},{"type":"text","text":" "},{"code":"mlpSequential","type":"codeVoice"},{"type":"text","text":". The whole block"},{"type":"text","text":" "},{"text":"is one graph node with a hand-written backward: ","type":"text"},{"type":"codeVoice","code":"x"},{"text":" feeds both the attention branch and the","type":"text"},{"text":" ","type":"text"},{"text":"first skip, and ","type":"text"},{"type":"codeVoice","code":"h"},{"text":" both the MLP branch and the second, and the skips are summed with device","type":"text"},{"text":" ","type":"text"},{"text":"ops, which ","type":"text"},{"type":"codeVoice","code":"Tensor"},{"text":"‘s operators can’t do on a batch.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Parameters."}],"type":"strong"},{"text":" ","type":"text"},{"type":"codeVoice","code":"weights"},{"text":" packs every inner layer’s weights flat, attention branch first","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"LN₁"},{"text":"‘s ","type":"text"},{"type":"codeVoice","code":"β | γ"},{"text":", then ","type":"text"},{"type":"codeVoice","code":"wQKV | wO"},{"text":"), then MLP branch (","type":"text"},{"type":"codeVoice","code":"LN₂"},{"type":"text","text":", then each "},{"type":"codeVoice","code":"Linear"},{"text":"), and the","type":"text"},{"type":"text","text":" "},{"text":"backward packs gradients the same way. ","type":"text"},{"code":"Adam","type":"codeVoice"},{"type":"text","text":" reads "},{"code":"allowsWeightDecay","type":"codeVoice"},{"type":"text","text":" per top-level layer,"},{"type":"text","text":" "},{"type":"text","text":"so the block’s own flag decides for all of those: with the default "},{"code":"true","type":"codeVoice"},{"type":"text","text":" the inner layer norms"},{"type":"text","text":" "},{"type":"text","text":"are decayed with the projections, although they’re built with "},{"code":"allowsWeightDecay: false","type":"codeVoice"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"text","text":"with "},{"code":"false","type":"codeVoice"},{"type":"text","text":" the projections aren’t decayed either. That gap closes when a layer group can hand"},{"type":"text","text":" "},{"code":"Adam","type":"codeVoice"},{"type":"text","text":" a per-scalar decay mask."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Every forward pass receives the whole mini-batch packed into one tensor ("},{"code":"size.batchCount","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"samples of "},{"code":"inputSize","type":"codeVoice"},{"type":"text","text":"). See "},{"code":"docs\/WRITING_A_LAYER.md","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/neuron\/transformerblock"]}],"references":{"doc://Neuron/documentation/Neuron/TransformerBlock/forward(tensor:context:)":{"url":"\/documentation\/neuron\/transformerblock\/forward(tensor:context:)","title":"forward(tensor:context:)","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"forward","kind":"identifier"},{"kind":"text","text":"("},{"text":"tensor","kind":"externalParam"},{"kind":"text","text":": "},{"text":"Tensor","preciseIdentifier":"s:6Neuron6TensorC","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"context","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"NetworkContext","preciseIdentifier":"s:6Neuron14NetworkContextV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Tensor","preciseIdentifier":"s:6Neuron6TensorC","kind":"typeIdentifier"}],"identifier":"doc:\/\/Neuron\/documentation\/Neur