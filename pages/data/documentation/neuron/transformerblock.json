{"topicSections":[{"generated":true,"title":"Initializers","identifiers":["doc:\/\/Neuron\/documentation\/Neuron\/TransformerBlock\/init(from:)","doc:\/\/Neuron\/documentation\/Neuron\/TransformerBlock\/init(inputSize:heads:feedForward:initializer:outputInitializer:allowsWeightDecay:linkId:)"],"anchor":"Initializers"},{"generated":true,"title":"Instance Properties","identifiers":["doc:\/\/Neuron\/documentation\/Neuron\/TransformerBlock\/feedForward-swift.property","doc:\/\/Neuron\/documentation\/Neuron\/TransformerBlock\/heads","doc:\/\/Neuron\/documentation\/Neuron\/TransformerBlock\/isTraining","doc:\/\/Neuron\/documentation\/Neuron\/TransformerBlock\/weights"],"anchor":"Instance-Properties"},{"generated":true,"title":"Instance Methods","identifiers":["doc:\/\/Neuron\/documentation\/Neuron\/TransformerBlock\/apply(gradients:learningRate:)","doc:\/\/Neuron\/documentation\/Neuron\/TransformerBlock\/encode(to:)","doc:\/\/Neuron\/documentation\/Neuron\/TransformerBlock\/forward(tensor:context:)","doc:\/\/Neuron\/documentation\/Neuron\/TransformerBlock\/onBatchSizeSet()","doc:\/\/Neuron\/documentation\/Neuron\/TransformerBlock\/onInputSizeSet()"],"anchor":"Instance-Methods"},{"generated":true,"title":"Enumerations","identifiers":["doc:\/\/Neuron\/documentation\/Neuron\/TransformerBlock\/FeedForward-swift.enum"],"anchor":"Enumerations"}],"relationshipsSections":[{"type":"inheritsFrom","title":"Inherits From","identifiers":["doc:\/\/Neuron\/documentation\/Neuron\/BaseLayerGroup"],"kind":"relationships"},{"type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/Neuron\/documentation\/Neuron\/Layer","doc:\/\/Neuron\/documentation\/Neuron\/LayerGrouping","doc:\/\/Neuron\/Se","doc:\/\/Neuron\/SE"],"kind":"relationships"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/Neuron\/documentation\/Neuron"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TransformerBlock","kind":"identifier"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"codeListing","syntax":null,"code":["h = x + Attn(LN₁(x))","y = h + MLP(LN₂(h)),   MLP = Linear(4C) → GeLU → Linear(C)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"With "},{"type":"codeVoice","code":"feedForward: .mixtureOfExperts"},{"type":"text","text":", the MLP is a "},{"type":"codeVoice","code":"MixtureOfExperts"},{"type":"text","text":" instead: each token"},{"type":"text","text":" "},{"type":"text","text":"goes through the top "},{"type":"codeVoice","code":"k"},{"type":"text","text":" of "},{"type":"codeVoice","code":"E"},{"type":"text","text":" such MLPs, as in GPT-4-shaped (Switch \/ Mixtral) models."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both layer norms take statistics per token ("},{"type":"codeVoice","code":"LayerNormalize(normalizing: .columns, epsilon: 1e-5)"},{"type":"text","text":"), and the attention is causal ("},{"type":"codeVoice","code":"MultiHeadAttention(heads: H, causal: true)"},{"type":"text","text":"), so"},{"type":"text","text":" "},{"type":"text","text":"position "},{"type":"codeVoice","code":"t"},{"type":"text","text":" of the output depends only on positions "},{"type":"codeVoice","code":"0...t"},{"type":"text","text":" of the input. Both "},{"type":"codeVoice","code":"Linear"},{"type":"text","text":"s have"},{"type":"text","text":" "},{"type":"text","text":"biases, and there is no dropout. Not yet checked numerically against PyTorch."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Input and output are "},{"type":"codeVoice","code":"(columns: C, rows: 1, depth: T)"},{"type":"text","text":". As with "},{"type":"codeVoice","code":"MultiHeadAttention"},{"type":"text","text":", every"},{"type":"text","text":" "},{"type":"text","text":"sample must be exactly "},{"type":"codeVoice","code":"T"},{"type":"text","text":" tokens long; right-pad a shorter one."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Stacking."}]},{"type":"text","text":" A GPT stacks "},{"type":"codeVoice","code":"N"},{"type":"text","text":" blocks between "},{"type":"codeVoice","code":"PositionalEmbedding"},{"type":"text","text":" and a final"},{"type":"text","text":" "},{"type":"codeVoice","code":"LayerNormalize(normalizing: .columns)"},{"type":"text","text":", and passes "},{"type":"codeVoice","code":"outputInitializer: .normal(std: 0.02 \/ √(2N))"},{"type":"text","text":" so the "},{"type":"codeVoice","code":"2N"},{"type":"text","text":" projections that add into the residual stream start"},{"type":"text","text":" "},{"type":"text","text":"smaller. "},{"type":"codeVoice","code":"RNN.Architecture.transformer"},{"type":"text","text":" builds that stack."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Structure."}]},{"type":"text","text":" The attention branch ("},{"type":"codeVoice","code":"LN₁"},{"type":"text","text":", "},{"type":"codeVoice","code":"MultiHeadAttention"},{"type":"text","text":") is "},{"type":"codeVoice","code":"innerBlockSequential"},{"type":"text","text":" "},{"type":"text","text":"and the MLP branch ("},{"type":"codeVoice","code":"LN₂"},{"type":"text","text":", then the two "},{"type":"codeVoice","code":"Linear"},{"type":"text","text":"s and the GeLU, or the "},{"type":"codeVoice","code":"MixtureOfExperts"},{"type":"text","text":") is"},{"type":"text","text":" "},{"type":"codeVoice","code":"mlpSequential"},{"type":"text","text":". The whole block"},{"type":"text","text":" "},{"type":"text","text":"is one graph node with a hand-written backward: "},{"type":"codeVoice","code":"x"},{"type":"text","text":" feeds both the attention branch and the"},{"type":"text","text":" "},{"type":"text","text":"first skip, and "},{"type":"codeVoice","code":"h"},{"type":"text","text":" both the MLP branch and the second, and the skips are summed with device"},{"type":"text","text":" "},{"type":"text","text":"ops, which "},{"type":"codeVoice","code":"Tensor"},{"type":"text","text":"‘s operators can’t do on a batch."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Parameters."}]},{"type":"text","text":" "},{"type":"codeVoice","code":"weights"},{"type":"text","text":" packs every inner layer’s weights flat, attention branch first"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"LN₁"},{"type":"text","text":"‘s "},{"type":"codeVoice","code":"β | γ"},{"type":"text","text":", then "},{"type":"codeVoice","code":"wQKV | wO"},{"type":"text","text":"), then MLP branch ("},{"type":"codeVoice","code":"LN₂"},{"type":"text","text":", then each "},{"type":"codeVoice","code":"Linear"},{"type":"text","text":"), and the"},{"type":"text","text":" "},{"type":"text","text":"backward packs gradients the same way. "},{"type":"codeVoice","code":"Adam"},{"type":"text","text":" reads "},{"type":"codeVoice","code":"allowsWeightDecay"},{"type":"text","text":" per top-level layer,"},{"type":"text","text":" "},{"type":"text","text":"so the block’s own flag decides for all of those: with the default "},{"type":"codeVoice","code":"true"},{"type":"text","text":" the inner layer norms"},{"type":"text","text":" "},{"type":"text","text":"are decayed with the projections, although they’re built with "},{"type":"codeVoice","code":"allowsWeightDecay: false"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"text","text":"with "},{"type":"codeVoice","code":"false"},{"type":"text","text":" the projections aren’t decayed either. That gap closes when a layer group can hand"},{"type":"text","text":" "},{"type":"codeVoice","code":"Adam"},{"type":"text","text":" a per-scalar decay mask."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every forward pass receives the whole mini-batch packed into one tensor ("},{"type":"codeVoice","code":"size.batchCount"},{"type":"text","text":" "},{"type":"text","text":"samples of "},{"type":"codeVoice","code":"inputSize"},{"type":"text","text":"). See "},{"type":"codeVoice","code":"docs\/WRITING_A_LAYER.md"},{"type":"text","text":"."}]}],"kind":"content"}],"kind":"symbol","sections":[],"metadata":{"role":"symbol","title":"TransformerBlock","navigatorTitle":[{"kind":"identifier","text":"TransformerBlock"}],"roleHeading":"Class","modules":[{"name":"Neuron"}],"externalID":"s:6Neuron16TransformerBlockC","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TransformerBlock","kind":"identifier"}],"symbolKind":"class"},"abstract":[{"type":"text","text":"A pre-norm transformer decoder block, as in GPT-2 (nanoGPT’s "},{"type":"codeVoice","code":"Block"},{"type":"text","text":"):"}],"identifier":{"url":"doc:\/\/Neuron\/documentation\/Neuron\/TransformerBlock","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/neuron\/transformerblock"]}],"references":{"doc://Neuron/Se":{"type":"unresolvable","identifier":"doc:\/\/Neuron\/Se","title":"Swift.Decodable"},"doc://Neuron/documentation/Neuron/TransformerBlock/FeedForward-swift.enum":{"role":"symbol","title":"TransformerBlock.FeedForward","navigatorTitle":[{"kind":"identifier","text":"FeedForward"}],"type":"topic","kind":"symbol","abstract":[{"text":"The feed-forward half of the block, after ","type":"text"},{"code":"LN₂","type":"codeVoice"},{"text":".","type":"text"}],"url":"\/documentation\/neuron\/transformerblock\/feedforward-swift.enum","identifier":"doc:\/\/Neuron\/documentation\/Neuron\/TransformerBlock\/FeedForward-swift.enum","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"FeedForward"}]},"doc://Neuron/documentation/Neuron/TransformerBlock/onBatchSizeSet()":{"identifier":