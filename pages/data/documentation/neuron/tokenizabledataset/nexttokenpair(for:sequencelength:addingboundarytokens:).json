{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Neuron\/documentation\/Neuron\/TokenizableDataset\/nextTokenPair(for:sequenceLength:addingBoundaryTokens:)"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"nextTokenPair"},{"kind":"text","text":"("},{"kind":"externalParam","text":"for"},{"kind":"text","text":" "},{"kind":"internalParam","text":"item"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"sequenceLength"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"addingBoundaryTokens"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":" = true) -> (data"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/Neuron\/documentation\/Neuron\/Tensor","text":"Tensor","kind":"typeIdentifier","preciseIdentifier":"s:6Neuron6TensorC"},{"text":", label","kind":"text"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:6Neuron6TensorC","identifier":"doc:\/\/Neuron\/documentation\/Neuron\/Tensor","kind":"typeIdentifier","text":"Tensor"},{"kind":"text","text":")"}]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Item to build a training pair from."}]}],"name":"item"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Token count both tensors are padded or truncated to."}]}],"name":"sequenceLength"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Wraps the item in "},{"type":"codeVoice","code":"<bos>"},{"text":"\/","type":"text"},{"code":"<eos>","type":"codeVoice"},{"type":"text","text":" when "},{"type":"codeVoice","code":"true"},{"type":"text","text":"."}]}],"name":"addingBoundaryTokens"}],"kind":"parameters"},{"content":[{"text":"Return Value","type":"heading","level":2,"anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"Input and label tensors, each of depth ","type":"text"},{"type":"codeVoice","code":"sequenceLength"},{"type":"text","text":"."}]}],"kind":"content"},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"inlineContent":[{"type":"text","text":"The label is the input advanced by exactly one token, so at timestep "},{"code":"i","type":"codeVoice"},{"type":"text","text":" the model sees"},{"type":"text","text":" "},{"type":"text","text":"token "},{"code":"i","type":"codeVoice"},{"type":"text","text":" and is scored on token "},{"code":"i + 1","type":"codeVoice"},{"type":"text","text":". The shift has to happen here, on the token"},{"type":"text","text":" "},{"type":"text","text":"sequence – shifting the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"text"}]},{"type":"text","text":" and re-encoding does not work, because tokenization is"},{"type":"text","text":" "},{"type":"text","text":"not shift-equivariant: dropping the first character of “the cat” re-encodes as"},{"type":"text","text":" "},{"code":"[\"he\", \"cat\", ...]","type":"codeVoice"},{"type":"text","text":", leaving every position after the first identical to the input and"},{"type":"text","text":" "},{"type":"text","text":"training the model to copy rather than predict."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Wrapping in "},{"code":"<bos>","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"<eos>","type":"codeVoice"},{"type":"text","text":" makes the first real token a prediction target and teaches"},{"type":"text","text":" "},{"type":"text","text":"the model to terminate, which is what "},{"code":"RNN.predict","type":"codeVoice"},{"type":"text","text":" keys off to stop generating."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":