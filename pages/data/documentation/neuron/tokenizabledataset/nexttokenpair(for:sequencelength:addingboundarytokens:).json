{"hierarchy":{"paths":[["doc:\/\/Neuron\/documentation\/Neuron","doc:\/\/Neuron\/documentation\/Neuron\/TokenizableDataset"]]},"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"nextTokenPair"},{"kind":"text","text":"("},{"kind":"externalParam","text":"for"},{"kind":"text","text":" "},{"kind":"internalParam","text":"item"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"sequenceLength"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"addingBoundaryTokens"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":" = true) -> (data"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/Neuron\/documentation\/Neuron\/Tensor","preciseIdentifier":"s:6Neuron6TensorC","text":"Tensor"},{"kind":"text","text":", label"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/Neuron\/documentation\/Neuron\/Tensor","preciseIdentifier":"s:6Neuron6TensorC","text":"Tensor"},{"kind":"text","text":")"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"item","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Item to build a training pair from."}]}]},{"name":"sequenceLength","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Token count both tensors are padded or truncated to."}]}]},{"name":"addingBoundaryTokens","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Wraps the item in "},{"type":"codeVoice","code":"<bos>"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"<eos>"},{"type":"text","text":" when "},{"type":"codeVoice","code":"true"},{"type":"text","text