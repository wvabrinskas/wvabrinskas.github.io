t":"."}]}],"kind":"content"},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The label is the input advanced by exactly one token, so at timestep "},{"type":"codeVoice","code":"i"},{"type":"text","text":" the model sees"},{"type":"text","text":" "},{"type":"text","text":"token "},{"type":"codeVoice","code":"i"},{"type":"text","text":" and is scored on token "},{"type":"codeVoice","code":"i + 1"},{"type":"text","text":". The shift has to happen here, on the token"},{"type":"text","text":" "},{"type":"text","text":"sequence – shifting the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"text"}]},{"type":"text","text":" and re-encoding does not work, because tokenization is"},{"type":"text","text":" "},{"type":"text","text":"not shift-equivariant: dropping the first character of “the cat” re-encodes as"},{"type":"text","text":" "},{"type":"codeVoice","code":"[\"he\", \"cat\", ...]"},{"type":"text","text":", leaving every position after the first identical to the input and"},{"type":"text","text":" "},{"type":"text","text":"training the model to copy rather than predict."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Wrapping in "},{"type":"codeVoice","code":"<bos>"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"<eos>"},{"type":"text","text":" makes the first real token a prediction target and teaches"},{"type":"text","text":" "},{"type":"text","text":"the model to terminate, which is what "},{"type":"codeVoice","code":"RNN.predict"},{"type":"text","text":" keys off to stop generating."}]}],"kind":"content"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://Neuron/documentation/Neuron/TokenizableDataset/nextTokenPair(for:sequenceLength:addingBoundaryTokens:)":{"title":"nextTokenPair(for:sequenceLength:addingBoundaryTokens:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"nextTokenPai