t":" heads of","type":"text"},{"text":" ","type":"text"},{"code":"d = C \/ H","type":"codeVoice"},{"text":" features each:","type":"text"}],"type":"paragraph"},{"code":["[Q | K | V] = x W_QKVᵀ + b_QKV                       (T × 3C)","headₕ       = softmax(Qₕ Kₕᵀ \/ √d) Vₕ                  (T × d), Qₕ = columns h·d..<(h+1)·d of Q","y           = [head₀ | … | head_(H−1)] W_Oᵀ + b_O     (T × C)"],"type":"codeListing","syntax":null},{"inlineContent":[{"text":"When ","type":"text"},{"code":"causal","type":"codeVoice"},{"text":", row ","type":"text"},{"code":"t","type":"codeVoice"},{"text":" of each softmax keeps only columns ","type":"text"},{"code":"0...t","type":"codeVoice"},{"text":", so output position ","type":"text"},{"code":"t","type":"codeVoice"},{"text":" ","type":"text"},{"text":"depends only on input positions ","type":"text"},{"code":"0...t","type":"codeVoice"},{"text":"; masked columns get a probability of exactly 0.","type":"text"},{"text":" ","type":"text"},{"text":"Without it, every position attends to every other.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Parameters."}],"type":"strong"},{"text":" ","type":"text"},{"code":"W_QKV","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"(columns: C, rows: 3C)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"W_O","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"(columns: C, rows: C)","type":"codeVoice"},{"text":", one","type":"text"},{"text":" ","type":"text"},{"text":"row per output feature, as ","type":"text"},{"code":"Linear","type":"codeVoice"},{"text":" and PyTorch’s ","type":"text"},{"code":"nn.Linear.weight","type":"codeVoice"},{"text":" store them. The biases are","type":"text"},{"text":" ","type":"text"},{"text":"always on and start at zero. All four are sized by ","type":"text"},{"code":"C","type":"codeVoice"},{"text":" alone, so ","type":"text"},{"code":"T","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"H",