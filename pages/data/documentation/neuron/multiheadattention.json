text":" can’t change output ","type":"text"},{"code":"t","type":"codeVoice"},{"text":", which is how ","type":"text"},{"code":"RNN.predict","type":"codeVoice"},{"text":" generates from a short window.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Cost."}],"type":"strong"},{"text":" Heads are split and merged with block transposes, never a per-head loop, and each","type":"text"},{"text":" ","type":"text"},{"text":"product is one batched matrix multiply over all ","type":"text"},{"code":"H · N","type":"codeVoice"},{"text":" (head, sample) pairs; ","type":"text"},{"code":"forward","type":"codeVoice"},{"text":" has","type":"text"},{"text":" ","type":"text"},{"text":"the layout. The attention matrices, ","type":"text"},{"code":"H · N · T²","type":"codeVoice"},{"text":" scalars, are kept for the backward.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"TransformerBlock","type":"codeVoice"},{"text":" wraps it with the layer norm, residual connections, and MLP.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Every forward pass receives the whole mini-batch packed into one tensor (","type":"text"},{"code":"size.batchCount","type":"codeVoice"},{"text":" ","type":"text"},{"text":"samples of ","type":"text"},{"code":"inputSize","type":"codeVoice"},{"text":"). See ","type":"text"},{"code":"docs\/WRITING_A_LAYER.md","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/Neuron\/documentation\/Neuron\/MultiHeadAttention","interfaceLanguage":"swift"},"topicSections":[{"identifiers":["doc:\/\/Neuron\/documentation\/Neuron\/MultiHeadAttention\/init(from:)","doc:\/\/Neuron\/documentation\/Neuron\/MultiHeadAttention\/init(inputSize:initializer:outputInitializer:heads:causal:allowsWeightDecay:linkId:)"],"anchor":"Initializers","title":"Initializers","generated":true},{"identifiers":["doc:\/\/Neuron\/documentation\/Neuron\/MultiHeadAttention\/bia